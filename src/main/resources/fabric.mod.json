{
    "schemaVersion": 1,
    "id": "rtx-remix-renderer",
    "version": "${version}",
    "name": "RTX Remix for Minecraft 1.21.4 (Unofficial Trial)",
    "description": "Unofficial experimental Minecraft 1.21.4 port of NVIDIA RTX Remix rendering. Not an NVIDIA release. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
    "authors": [
        "NVIDIA"
    ],
    "contact": {
        "homepage": "https://github.com/james891125/rtx-remix-minecraft/tree/trial/minecraft-1.21.4-installer",
        "sources": "https://github.com/james891125/rtx-remix-minecraft/tree/trial/minecraft-1.21.4-installer",
        "issues": "https://github.com/james891125/rtx-remix-minecraft/issues"
    },
    "license": "Apache-2.0",
    "environment": "*",
    "entrypoints": {
        "preLaunch": [
            "com.nvidia.rtxremix.minecraft.WorkerPoolCap"
        ],
        "main": [
            "com.nvidia.rtxremix.minecraft.RtxRemixCommonMod"
        ],
        "client": [
            "com.nvidia.rtxremix.minecraft.RtxRemixMod"
        ]
    },
    "mixins": [
        "rtx-remix-renderer.mixins.json"
    ],
    "accessWidener": "rtx-remix-renderer.accesswidener",
    "depends": {
        "fabricloader": ">=0.16.9",
        "fabric-api": ">=0.119.4+1.21.4",
        "minecraft": "1.21.4",
        "java": ">=21"
    }
}
